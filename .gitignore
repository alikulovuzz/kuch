# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config. .env holds POSTGRES_PASSWORD and may hold a DATABASE_URL with credentials, so
# variants of it are ignored too.
.env
.env.*
!.env.example

# Backups as docs/SELF_HOSTING.md and docs/POSTGRES_MIGRATION.md name them: everyone's data
kuch-backup-*
kuch-db-*
*.dump

# Android release signing: keystores and any local file holding their passwords. The key belongs
# outside the repo (frontend/android/app/build.gradle reads ~/.gradle/gradle.properties or the
# environment); these only stop a stray copy from being committed.
*.keystore
*.jks
*.p12
*.pfx
keystore.properties
signing.properties
*.keystore.properties
*.signing.properties

# Build output / deps
frontend/dist/
# release APKs + checksums (`npm run package:apk`); they go on the GitHub release, not in git
dist-apk/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/
